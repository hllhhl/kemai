{
  "name": "kemai-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "课脉桌面外壳：拉起本地后端并加载界面",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "cn.kemai.desktop",
    "productName": "课脉",
    "copyright": "基于 zhiye-review-agent (MIT)",
    "directories": {
      "output": "../_package/dist",
      "buildResources": "../assets"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../assets",
        "to": "assets"
      },
      {
        "from": "../decks",
        "to": "decks"
      },
      {
        "from": "../model-runtime",
        "to": "model-runtime",
        "filter": [
          "**/*",
          "**/node_modules/**/*"
        ]
      },
      {
        "from": "../_runtime/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/test/**",
          "!**/tests/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../assets/kemai.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "课脉"
    },
    "asar": true,
    "afterPack": "after-pack.js"
  }
}
